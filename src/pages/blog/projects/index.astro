---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogNav from '../../../components/BlogNav.astro';
import { devProjects } from '../../../data/devProjects';
import { withBase } from '../../../data/site';
---
<BaseLayout title="Projects — Devblog" active="blog">
  <div class="page-shell narrow-page blog-page">
    <header class="page-intro">
      <span class="page-kicker">Devblog</span>
      <h1>Projects.</h1>
      <p>Long-running development and research projects that connect the individual articles, experiments and portfolio work.</p>
    </header>

    <BlogNav active="projects" />

    <section class="dev-projects" aria-label="Development projects">
      {devProjects.map((project) => (
        <article class="dev-project">
          <div class="dev-project-copy">
            <h2>{project.title}</h2>
            <span class="dev-project-meta">{project.area}</span>
            <p>{project.description}</p>
            <a class="dev-project-link" href={withBase(project.href)}>{project.linkLabel} →</a>
          </div>
          <a class="dev-project-media" href={withBase(project.href)} aria-label={project.title}>
            <img src={withBase(project.image)} alt="" loading="lazy" />
          </a>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
