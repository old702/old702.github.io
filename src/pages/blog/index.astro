---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { posts } from '../../data/posts';
---
<BaseLayout title="Devblog" active="blog">
  <div class="page-shell narrow-page blog-page">
    <header class="page-intro">
      <span class="page-kicker">Writing · Research · Development</span>
      <h1>Devblog.</h1>
      <p>Technical notes, project breakdowns and working records from rendering, tools and game development.</p>
    </header>

    <section class="blog-list">
      {posts.map((post) => <BlogCard post={post} />)}
    </section>
  </div>
</BaseLayout>
