---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogNav from '../../components/BlogNav.astro';
import { posts } from '../../data/posts';
---
<BaseLayout title="Devblog" active="blog">
  <div class="page-shell narrow-page blog-page">
    <header class="page-intro">
      <span class="page-kicker">Research</span>
      <h1>Devblog.</h1>
      <p>Notes on rendering, tools, experiments and ongoing development.</p>
    </header>

    <BlogNav active="blog" />

    <section class="blog-list" aria-label="Latest posts">
      {posts.map((post) => <BlogCard post={post} />)}
    </section>
  </div>
</BaseLayout>
