---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { careerSummary, professionalExperience } from '../data/experience';
---
<BaseLayout title={`About — ${site.name}`} active="about">
  <div class="page-shell about-page">
    <header class="page-intro about-intro">
      <span class="page-kicker">Profile</span>
      <h1>About.</h1>
      <p class="about-role">{careerSummary.title}</p>
      <p>{careerSummary.body}</p>
    </header>

    <section class="experience-section about-experience" aria-labelledby="professional-experience">
      <h2 id="professional-experience">Professional experience</h2>
      {professionalExperience.map((entry) => (
        <article class="experience-entry">
          <h3>{entry.company}</h3>
          <p class="experience-position">{entry.role}</p>
          <div class="experience-meta">
            <span>{entry.period}</span>
            {entry.location && <span>{entry.location}</span>}
          </div>
          <p class="experience-description">{entry.description}</p>
          {entry.details && (
            <ul>
              {entry.details.map((detail) => <li>{detail}</li>)}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="about-contact">
      <h2>Contact</h2>
      <div class="simple-links">
        <a href={site.github}><span>GitHub</span><small>old702 ↗</small></a>
        {site.artstation && <a href={site.artstation}><span>ArtStation</span><small>Profile ↗</small></a>}
        {site.email && <a href={`mailto:${site.email}`}><span>Email</span><small>{site.email}</small></a>}
      </div>
    </section>
  </div>
</BaseLayout>