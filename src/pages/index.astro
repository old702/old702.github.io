---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { projects } from '../data/projects';
import { posts } from '../data/posts';

const galleryProjects = projects.filter((project) => project.destination === 'gallery');
const recentPosts = posts.slice(0, 3);
---
<BaseLayout active="work">
  <div class="page-shell work-page">
    <header class="page-intro home-intro">
      <span class="page-kicker">Portfolio</span>
      <h1>Selected work.</h1>
      <p>Selected environments, production tools, visual research and personal artwork.</p>
    </header>

    <section class="work-gallery" aria-label="Selected portfolio work">
      <div class="project-grid" id="projectGrid">
        {galleryProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <div class="work-browse">
      <span class="work-browse-label">Browse work</span>
      <div class="filter-row" role="group" aria-label="Work categories">
        <button type="button" data-filter="environment-art" aria-pressed="false">Environment Art</button>
        <button type="button" data-filter="tools" aria-pressed="false">Tools</button>
        <button type="button" data-filter="research" aria-pressed="false">Research</button>
        <button type="button" data-filter="fan-art" aria-pressed="false">Fan Art</button>
      </div>
    </div>

    <p class="empty-work" id="emptyWork" hidden>No projects in this category yet.</p>

    <section class="home-research" aria-labelledby="homeResearchTitle">
      <header class="home-research-head">
        <div>
          <span class="page-kicker">Research</span>
          <h2 id="homeResearchTitle">From the Devblog.</h2>
        </div>
        <a href={import.meta.env.BASE_URL + 'blog/'}>All articles →</a>
      </header>
      <div class="home-research-list">
        {recentPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  </div>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-row [data-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#projectGrid [data-categories]'));
    const empty = document.querySelector<HTMLElement>('#emptyWork');
    let selected = '';

    for (const button of filters) {
      button.addEventListener('click', () => {
        selected = selected === button.dataset.filter ? '' : (button.dataset.filter || '');

        for (const filter of filters) {
          const active = selected !== '' && filter.dataset.filter === selected;
          filter.classList.toggle('active', active);
          filter.setAttribute('aria-pressed', String(active));
        }

        let visible = 0;
        for (const card of cards) {
          const match = !selected || (card.dataset.categories || '').split(' ').includes(selected);
          card.hidden = !match;
          if (match) visible++;
        }

        if (empty) empty.hidden = visible !== 0;
      });
    }
  </script>
</BaseLayout>
