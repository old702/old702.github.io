---
import { withBase } from '../../data/site';

export function getStaticPaths() {
  const redirects = [
    { slug: 'subtransit', target: 'work/subtransit/' },
    { slug: 'texturepacker', target: 'work/texturepacker/' },
    { slug: 'blender-tools', target: 'work/blender-tools/' },
    { slug: 'tf2-tools', target: 'articles/tf2-demo-analysis/' },
  ];

  return redirects.map((item) => ({
    params: { slug: item.slug },
    props: { target: item.target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(withBase(target), 301);
---