---
import { projects } from '../../data/projects';
import { withBase } from '../../data/site';

export function getStaticPaths() {
  return projects
    .filter((project) => project.destination === 'gallery')
    .map((project) => ({ params: { slug: project.slug } }));
}
const { slug } = Astro.params;
return Astro.redirect(withBase(`work/${slug}/`), 301);
---