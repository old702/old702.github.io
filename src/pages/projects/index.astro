---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects } from '../../data/featuredProjects';
import { withBase } from '../../data/site';
---
<BaseLayout title="Projects" active="projects">
  <div class="page-shell narrow-page section-page projects-page">
    <header class="page-intro">
      <span class="page-kicker">Development</span>
      <h1>Projects.</h1>
      <p>Long-running game-development projects and collaborative work.</p>
    </header>

    <section class="featured-projects" aria-label="Selected projects">
      {featuredProjects.map((project) => (
        <article class="featured-project" id={project.slug}>
          <header>
            <h2>{project.title}</h2>
            <p class="featured-project-meta">{project.meta}</p>
          </header>

          {project.image && (
            <figure class="featured-project-media">
              <img src={withBase(project.image)} alt="" loading="lazy" />
            </figure>
          )}

          <p class="featured-project-description">{project.description}</p>

          {project.links && (
            <nav class="featured-project-links" aria-label={`${project.title} links`}>
              {project.links.map((link) => <a href={withBase(link.href)}>{link.label} →</a>)}
            </nav>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>