---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { careerSummary, professionalExperience, earlyExperience } from '../../data/experience';
---
<BaseLayout title="Projects" active="projects">
  <div class="page-shell narrow-page section-page experience-page">
    <header class="page-intro experience-intro">
      <span class="page-kicker">Experience</span>
      <h1>Projects.</h1>
      <p class="experience-role">{careerSummary.title}</p>
      <p>{careerSummary.body}</p>
    </header>

    <section class="experience-section" aria-labelledby="professional-experience">
      <h2 id="professional-experience">Professional experience</h2>
      {professionalExperience.map((entry) => (
        <article class="experience-entry">
          <h3>{entry.company}</h3>
          <p class="experience-position">{entry.role}</p>
          <div class="experience-meta">
            <span>{entry.period}</span>
            {entry.location && <span>{entry.location}</span>}
          </div>
          <p class="experience-description">{entry.description}</p>
          {entry.details && (
            <ul>
              {entry.details.map((detail) => <li>{detail}</li>)}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="experience-section" aria-labelledby="early-work">
      <h2 id="early-work">Earlier work & modding</h2>
      {earlyExperience.map((entry) => (
        <article class="experience-entry">
          <h3>{entry.company}</h3>
          <p class="experience-position">{entry.role}</p>
          <div class="experience-meta"><span>{entry.period}</span></div>
          <p class="experience-description">{entry.description}</p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>