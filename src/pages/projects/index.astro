---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects } from '../../data/featuredProjects';
import { withBase } from '../../data/site';
---
<BaseLayout title="Projects" active="projects">
  <div class="page-shell narrow-page section-page projects-page">
    <header class="page-intro">
      <span class="page-kicker">Development</span>
      <h1>Projects.</h1>
      <p>Long-running game-development projects and collaborative work.</p>
    </header>

    <section class="project-capsule-grid" aria-label="Selected projects">
      {featuredProjects.map((project) => (
        <article class="project-capsule-card" id={project.slug}>
          {project.primaryHref ? (
            <a class="project-capsule-media" href={withBase(project.primaryHref)} aria-label={project.title}>
              {project.image
                ? <img src={withBase(project.image)} alt="" loading="lazy" />
                : <span class="project-capsule-placeholder"><span>{project.title}</span></span>}
            </a>
          ) : (
            <div class="project-capsule-media">
              {project.image
                ? <img src={withBase(project.image)} alt="" loading="lazy" />
                : <span class="project-capsule-placeholder"><span>{project.title}</span></span>}
            </div>
          )}

          <div class="project-capsule-copy">
            <h2>{project.title}</h2>
            <p class="project-capsule-meta">{project.meta}</p>
            <p class="project-capsule-description">{project.description}</p>

            {project.links && (
              <nav class="project-capsule-links" aria-label={`${project.title} links`}>
                {project.links.map((link) => <a href={withBase(link.href)}>{link.label} →</a>)}
              </nav>
            )}
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>