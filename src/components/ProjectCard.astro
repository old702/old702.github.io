---
import type { Project } from '../data/projects';
import { withBase } from '../data/site';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const href = project.destination === 'article'
  ? withBase(`blog/${project.article}/`)
  : withBase(`projects/${project.slug}/`);
---
<a class:list={['project-card', project.size]} href={href} data-categories={project.categories.join(' ')}>
  <img src={withBase(project.cover)} alt="" loading={project.size === 'featured' ? 'eager' : 'lazy'} />
  <span class="destination-badge">{project.destination}</span>
  <span class="project-index">{String(index + 1).padStart(3, '0')}</span>
  <span class="project-overlay">
    <span class="project-kicker">{project.kicker}</span>
    <span class="project-title">{project.title}</span>
    <span class="project-meta">{project.meta}</span>
  </span>
</a>
