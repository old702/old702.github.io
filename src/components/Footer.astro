---
import { site, withBase } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-mark" href={withBase('')} aria-label="Home"><img src={site.avatar} alt="" /></a>
      <div><strong>{site.name}</strong><p>{site.description}</p></div>
    </div>
    <div class="footer-links">
      <div>
        <span>Pages</span>
        <a href={withBase('')}>Work</a>
        <a href={withBase('articles/')}>Articles</a>
        <a href={withBase('projects/')}>Projects</a>
        <a href={withBase('about/')}>About</a>
      </div>
      <div>
        <span>Elsewhere</span>
        <a href={site.github}>GitHub</a>
        {site.artstation && <a href={site.artstation}>ArtStation</a>}
        {site.email && <a href={`mailto:${site.email}`}>Email</a>}
      </div>
    </div>
  </div>
  <div class="footer-note">© 2026 · Game development, rendering and tools.</div>
</footer>