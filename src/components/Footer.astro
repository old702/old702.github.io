---
import { site, withBase } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-mark" href={withBase('')}>AI</a>
      <div>
        <strong>{site.name}</strong>
        <p>{site.description}</p>
      </div>
    </div>

    <div class="footer-links">
      <div>
        <span>Pages</span>
        <a href={withBase('')}>Work</a>
        <a href={withBase('blog/')}>Blog</a>
        <a href={withBase('about/')}>About</a>
      </div>
      <div>
        <span>Elsewhere</span>
        <a href={site.github}>GitHub</a>
        <a href={site.artstation}>ArtStation</a>
      </div>
    </div>
  </div>
  <div class="footer-note">© 2026 · Game development, rendering and tools.</div>
</footer>
