---
import { withBase } from '../data/site';
interface Props { active: 'blog' | 'articles' | 'projects' }
const { active } = Astro.props;
---
<nav class="blog-section-nav" aria-label="Devblog sections">
  <a class:list={[{ active: active === 'blog' }]} href={withBase('blog/')}>Blog</a>
  <a class:list={[{ active: active === 'articles' }]} href={withBase('blog/articles/')}>Articles</a>
  <a class:list={[{ active: active === 'projects' }]} href={withBase('blog/projects/')}>Projects</a>
</nav>
