---
import type { Post } from '../data/posts';
import { withBase } from '../data/site';
interface Props { post: Post }
const { post } = Astro.props;
---
<a class="post-card" href={withBase(`blog/${post.slug}/`)}>
  <span class="post-thumb"><img src={withBase(post.thumbnail)} alt="" loading="lazy" /></span>
  <span class="post-main">
    <span class="post-meta-line">{post.date} · {post.category} · {post.readTime}</span>
    <span class="post-title">{post.title}</span>
    <span class="post-excerpt">{post.excerpt}</span>
  </span>
</a>
