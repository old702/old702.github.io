---
import BaseLayout from './BaseLayout.astro';
interface TocItem { label: string; href: string }
interface Props {
  title: string;
  subtitle: string;
  description: string;
  date: string;
  updated?: string;
  readTime: string;
  articleId: string;
  project: string;
  category: string;
  platform: string;
  status: string;
  tags?: string[];
  toc: TocItem[];
}
const props = Astro.props;
---
<BaseLayout title={`${props.title} — Blog`} description={props.description} active="blog">
  <div class="wrap">
    <div class="topline"><span>Blog / {props.category}</span><span>Technical Note</span></div>
    <header class="article-head">
      <div class="article-meta">{props.date} · {props.readTime}{props.updated ? ` · Updated ${props.updated}` : ''}</div>
      <h1>{props.title}</h1>
      <div class="subtitle">{props.subtitle}</div>
      <p>{props.description}</p>
    </header>

    <div class="article-fields">
      <div><span>Project</span><strong>{props.project}</strong></div>
      <div><span>Topic</span><strong>{props.category}</strong></div>
      <div><span>Platform</span><strong>{props.platform}</strong></div>
      <div><span>Status</span><strong>{props.status}</strong></div>
    </div>

    <div class="article-layout">
      <aside class="article-side">
        <span>{props.articleId}</span>
        <span>{props.category}</span>
        <span>{props.platform}</span>
        {props.tags?.map((tag) => <span>{tag}</span>)}
      </aside>

      <article class="article-body"><slot /></article>

      <aside class="article-toc">
        <strong>On This Page</strong>
        {props.toc.map((item, i) => <a href={item.href}>{String(i + 1).padStart(2, '0')} {item.label}</a>)}
      </aside>
    </div>
  </div>
</BaseLayout>
