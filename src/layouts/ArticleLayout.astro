---
import BaseLayout from './BaseLayout.astro';
interface TocItem { label: string; href: string }
interface Props {
  title: string;
  subtitle: string;
  description: string;
  date: string;
  updated?: string;
  readTime: string;
  articleId: string;
  project: string;
  category: string;
  platform: string;
  status: string;
  tags?: string[];
  toc: TocItem[];
}
const props = Astro.props;
---
<BaseLayout title={`${props.title} — Blog`} description={props.description} active="blog">
  <div class="article-shell">
    <header class="article-head clean">
      <a class="article-back" href={import.meta.env.BASE_URL + 'blog/'}>← Blog</a>
      <div class="article-meta">{props.date} · {props.readTime}{props.updated ? ` · Updated ${props.updated}` : ''}</div>
      <h1>{props.title}</h1>
      <p class="article-lede">{props.description}</p>

      <div class="article-tags">
        <span>{props.project}</span>
        <span>{props.category}</span>
        <span>{props.platform}</span>
        {props.tags?.map((tag) => <span>{tag}</span>)}
      </div>

      {props.toc.length > 0 && (
        <nav class="article-inline-toc" aria-label="On this page">
          <strong>On this page</strong>
          {props.toc.map((item, i) => <a href={item.href}>{String(i + 1).padStart(2, '0')} {item.label}</a>)}
        </nav>
      )}
    </header>

    <article class="article-body clean-body"><slot /></article>
  </div>
</BaseLayout>
