---
import BaseLayout from './BaseLayout.astro';
interface TocItem { label: string; href: string }
interface Props {
  title: string;
  subtitle: string;
  description: string;
  date: string;
  updated?: string;
  readTime: string;
  articleId: string;
  project: string;
  category: string;
  platform: string;
  status: string;
  tags?: string[];
  toc: TocItem[];
}
const props = Astro.props;
---
<BaseLayout title={`${props.title} — Devblog`} description={props.description} active="blog">
  <div class="article-shell">
    <header class="article-head clean">
      <a class="article-back" href={import.meta.env.BASE_URL + 'blog/'}>← Devblog</a>

      <div class="article-meta">
        <span>{props.date}</span>
        <span>{props.readTime}</span>
        {props.updated && <span>Updated {props.updated}</span>}
      </div>

      <h1>{props.title}</h1>
      <p class="article-lede">{props.description}</p>

      {props.toc.length > 0 && (
        <nav class="article-inline-toc" aria-label="On this page">
          <strong>On this page</strong>
          <div>
            {props.toc.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </nav>
      )}
    </header>

    <article class="article-body clean-body"><slot /></article>
  </div>
</BaseLayout>
